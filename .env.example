# =============================================================================
# RSAMAXXED — Environment Variables
# Copy this file to .env and fill in your values.  `.env` is gitignored and
# never leaves this machine; no broker credential is ever sent to the cloud.
# =============================================================================
#
# YOU DO NOT NEED ANYTHING IN THIS FILE TO RECEIVE THE PLAYS.
#
# No account, no sign-up, no password, no pairing code, no key, no Discord.
# Launch the terminal and the buy alerts, the exits and the round-up
# (fractional) board download on their own, then refresh every hour for as long
# as it is open. The feed is free and open.
#
# Everything below is either a BROKER LOGIN, so the terminal can place your own
# trades, or an OPERATOR setting for whoever publishes the feed.
# =============================================================================

# --- BBAE ---
# Single account only
BBAE_USER=
BBAE_PASSWORD=

# --- Chase ---
# Single login — trades across ALL sub-accounts automatically
CHASE_USERNAME=
CHASE_PASSWORD=
# CHASE_HEADLESS=true

# --- DSPAC ---
# Single account only
DSPAC_USER=
DSPAC_PASSWORD=

# --- Fennel ---
# Comma-separated emails for multiple accounts
# FENNEL_EMAIL=email1@x.com,email2@x.com
FENNEL_EMAIL=

# --- Fidelity ---
# MULTI-ACCOUNT: comma-separated  user:pass:totp,user2:pass2:totp2
# Trades across ALL sub-accounts within each login automatically
# FIDELITY=user:pass:totp,user2:pass2:totp2
# OR single account:
FIDELITY_USERNAME=
FIDELITY_PASSWORD=
FIDELITY_TOTP_SECRET=
# FIDELITY_HEADLESS=true

# --- Public ---
# Multiple logins via numbered tokens
PUBLIC_SECRET_TOKEN_1=
# PUBLIC_SECRET_TOKEN_2=
# PUBLIC_SECRET_TOKEN_3=

# --- Robinhood ---
# MULTI-ACCOUNT: comma-separated  user:pass,user2:pass2
# ROBINHOOD=user:pass,user2:pass2
# OR single account:
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=

# --- Schwab ---
# MULTI-ACCOUNT: comma-separated  user:pass:totp,user2:pass2:totp2
# Trades across ALL sub-accounts within each login automatically
# SCHWAB=user:pass:totp,user2:pass2:totp2
# OR single account:
SCHWAB_USERNAME=
SCHWAB_PASSWORD=
SCHWAB_TOTP_SECRET=

# --- SoFi ---
# Single login — trades across ALL sub-accounts automatically
SOFI_USERNAME=
SOFI_PASSWORD=
SOFI_TOTP_SECRET=
# SOFI_HEADLESS=true

# --- Wells Fargo ---
# Single login — trades across ALL sub-accounts automatically
WELLSFARGO_USERNAME=
WELLSFARGO_PASSWORD=
# WELLSFARGO_HEADLESS=false


# =============================================================================
# CLOUD (optional — the plays arrive without any of this)
# =============================================================================
# Point the terminal at another deployment — local dev, or self-hosted.
# Unset uses the hosted service.
# RSAMAXXED_CLOUD_URL=http://127.0.0.1:8000

# Not needed for the hosted feed, which is open. It exists for a SELF-HOSTED
# deployment that chose to put its own feed behind a password. Harmless if you
# leave it set from an older install — the server ignores it.
# RSAMAXXED_PLAYS_KEY=


# =============================================================================
# OPERATOR ONLY — everything below.
#
# These belong to the ONE machine that publishes the feed everyone else reads.
# If you downloaded this to trade your own accounts, leave all of it blank: the
# app then never contacts Discord and never attempts to publish.
# =============================================================================

# Ingest key for POST /api/v1/plays/ingest; must match FEED_INGEST_KEY on the
# server. Unset makes publishing a silent no-op, which is the right default for
# every copy but one.
# RSAMAXXED_FEED_KEY=

# Reading the alert channels requires a Discord account that is a member of
# them. NOTE: automating a *user* token is against Discord's ToS. It exists so
# the operator can mirror alerts into the feed; customers receive the same data
# from the feed with none of this.
# DISCORD_TOKEN=

# Channel IDs, not names. The real channels are named with styled unicode
# (e.g. '📫│𝙱𝚄𝚈'), so a plain "BUY" resolves to nothing. Enable Developer Mode
# in Discord and right-click a channel to copy its id.
# DISCORD_CHANNEL_ID=            # BUY   — plays to open
# DISCORD_SELL_CHANNEL_ID=       # SELL  — exits and round-up confirmations
# DISCORD_LIFECYCLE_CHANNEL=     # TRACK — the board saying what each split did
# DISCORD_SERVER=                # optional; narrows a name lookup to one server

# Shows operator affordances in the UI. Not a security boundary.
# RSAMAXXED_ADMIN=
