# =============================================================================
# RSAMAXXED — Environment Variables
# Copy this file to .env and fill in your values.  `.env` is gitignored and
# never leaves this machine; no broker credential is ever sent to the cloud.
# =============================================================================
#
# YOU DO NOT NEED ANYTHING IN THIS FILE TO RECEIVE THE PLAYS.
#
# No account, no sign-up, no password, no pairing code, no key, nothing to join.
# Launch the terminal and the buy alerts, the exits and the round-up
# (fractional) board download on their own, then refresh every hour for as long
# as it is open. The feed is free and open.
#
# Everything below is either a BROKER LOGIN, so the terminal can place your own
# trades, or an OPERATOR setting for whoever publishes the feed.
# =============================================================================

# --- BBAE ---
# Single account only
BBAE_USER=
BBAE_PASSWORD=

# --- Chase ---
# Single login — trades across ALL sub-accounts automatically
CHASE_USERNAME=
CHASE_PASSWORD=
# CHASE_HEADLESS=true

# --- DSPAC ---
# Single account only
DSPAC_USER=
DSPAC_PASSWORD=

# --- Fennel ---
# Comma-separated emails for multiple accounts
# FENNEL_EMAIL=email1@x.com,email2@x.com
FENNEL_EMAIL=

# --- Fidelity ---
# MULTI-ACCOUNT: comma-separated  user:pass:totp,user2:pass2:totp2
# Trades across ALL sub-accounts within each login automatically
# FIDELITY=user:pass:totp,user2:pass2:totp2
# OR single account:
FIDELITY_USERNAME=
FIDELITY_PASSWORD=
FIDELITY_TOTP_SECRET=
# FIDELITY_HEADLESS=true

# --- Public ---
# Multiple logins via numbered tokens
PUBLIC_SECRET_TOKEN_1=
# PUBLIC_SECRET_TOKEN_2=
# PUBLIC_SECRET_TOKEN_3=

# --- Robinhood ---
# MULTI-ACCOUNT: comma-separated  user:pass,user2:pass2
# ROBINHOOD=user:pass,user2:pass2
# OR single account:
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=

# --- Schwab ---
# MULTI-ACCOUNT: comma-separated  user:pass:totp,user2:pass2:totp2
# Trades across ALL sub-accounts within each login automatically
# SCHWAB=user:pass:totp,user2:pass2:totp2
# OR single account:
SCHWAB_USERNAME=
SCHWAB_PASSWORD=
SCHWAB_TOTP_SECRET=

# --- SoFi ---
# Single login — trades across ALL sub-accounts automatically
SOFI_USERNAME=
SOFI_PASSWORD=
SOFI_TOTP_SECRET=
# SOFI_HEADLESS=true

# --- Wells Fargo ---
# Single login — trades across ALL sub-accounts automatically
WELLSFARGO_USERNAME=
WELLSFARGO_PASSWORD=
# WELLSFARGO_HEADLESS=false


# =============================================================================
# BACKGROUND OPERATION (leave these alone unless you are debugging)
# =============================================================================
# A trade signs into every linked broker, and four of them (Chase, Fidelity,
# SoFi, Wells Fargo) drive a real Chrome to do it. By default none of that is
# allowed on screen: no console windows, and any browser that has to run headed
# is opened off the visible desktop with no taskbar button.
#
# Set this to false to watch it all happen — browsers on screen, where you can
# see which step a broker is stuck on.
# RSA_BACKGROUND=true
#
# Off-screen, not hidden, is deliberate: Chrome stops drawing a window it
# believes nobody can see, and the brokers read screenshots of the page to spot
# a human-check wall. Set this to true to really hide the window and give those
# diagnostics up.
# RSA_BROWSER_HIDE=false
#
# Quietest of all is headless, which opens no window at all. Chase, Fidelity and
# SoFi already default to it above; Wells Fargo does not, because its sign-on
# page stalls headless.


# =============================================================================
# CLOUD (optional — the plays arrive without any of this)
# =============================================================================
# Point the terminal at another deployment — local dev, or self-hosted.
# Unset uses the hosted service.
# RSAMAXXED_CLOUD_URL=http://127.0.0.1:8000

# Not needed for the hosted feed, which is open. It exists for a SELF-HOSTED
# deployment that chose to put its own feed behind a password. Harmless if you
# leave it set from an older install — the server ignores it.
# RSAMAXXED_PLAYS_KEY=


# =============================================================================
# OPERATOR ONLY — everything below.
#
# These belong to the ONE machine that publishes the feed everyone else reads.
# If you downloaded this to trade your own accounts, leave all of it blank: the
# app then never contacts the upstream feed and never attempts to publish.
# =============================================================================

# Ingest key for POST /api/v1/plays/ingest; must match FEED_INGEST_KEY on the
# server. Unset makes publishing a silent no-op, which is the right default for
# every copy but one.
# RSAMAXXED_FEED_KEY=

# Reading the alert channels requires an account on the upstream service that
# is a member of them. NOTE: automating a *user* token is against that
# service's ToS. It exists so the operator can mirror alerts into the feed;
# customers receive the same data from the feed with none of this.
# FEED_TOKEN=

# Channel IDs, not names. The real channels are named with styled unicode
# (e.g. '📫│𝙱𝚄𝚈'), so a plain "BUY" resolves to nothing.
# FEED_CHANNEL_ID=               # BUY   — plays to open
# FEED_SELL_CHANNEL_ID=          # SELL  — exits and round-up confirmations
# FEED_LIFECYCLE_CHANNEL=        # TRACK — the board saying what each split did
# FEED_SERVER=                   # optional; narrows a name lookup to one server

# Shows operator affordances in the UI. Not a security boundary.
# RSAMAXXED_ADMIN=

# ---------------------------------------------------------------------------
# More than one login at the same broker
#
# Every broker takes as many logins as you have. Add them on the Brokers page
# rather than by hand -- it writes these keys for you -- but this is the shape:
#
#   login 1  keeps the plain key it has always used   CHASE_USERNAME=
#   login 2+ take a numbered suffix                   CHASE_USERNAME_2=
#   Public numbers from 1, as it always has           PUBLIC_SECRET_TOKEN_1=
#   Fidelity/Robinhood/Schwab pack theirs in one      FIDELITY=u:p:totp,u2:p2
#   Fennel is a comma-separated email list            FENNEL_EMAIL=a@x,b@y
#
# A TAG names a login so a household can tell two sets of accounts apart. It
# is a label only -- it never reaches an account id, an order, or the journal,
# so renaming one breaks nothing.
#
# CHASE_TAG_1=myles
# CHASE_TAG_2=the other one
#
# NEVER renumber an existing login. The number is in its account labels, and
# trades.json nets buys against sells on those labels -- shifting one orphans
# every open position under it. Deleting login 2 leaves a gap on purpose.
