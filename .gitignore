# What automation did, run by run — holds real broker account ids.
mirror_runs.json
discord_state.json
watchlist.json
*.exe
.claude/

# Holds this machine's RSAMAXXED Cloud device bearer token.
cloud_state.json

# Web app (web/)
web/local.db
web/.env

.pytest_cache/

# Local pick/feed state, same class as mirror_state.json above.
picks_done.json
sells.json
lifecycle_state.json

# Reference copies of other people's decompiled binaries. Kept locally for
# study; committing them to a PUBLIC repo would republish someone else's
# copyrighted source under our name.
Fractional _Automation.py
*_decompiled.py

# The live pick list. It is the product; the desktop app now syncs it from the
# authenticated cloud feed, and web/picks.json is the deliberate free-tier copy.
picks.json
# Including web/picks.json, which the rule above already covers at every depth.
# That copy used to be COMMITTED by publish_picks.py so a Railway redeploy would
# seed the feed from it — the pre-ingest design. Plays reach customers over the
# authenticated feed now, and a public repo is the one place the product must
# not sit: anyone cloning it read the plays without subscribing.

# Operator-only scheduler wrapper. Customers never publish, so this
# stays off the public repo alongside the feed key it depends on.
publish_feed_task.bat

# The full feed archive — the product itself. Never on the public repo.
feed_archive.json
feed_archive.corrupt.json
