# Copy to .env for local dev. On Railway, set these as service variables.

# Sign the session cookie. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# MUST be set in production. Rotating it logs everyone out.
SECRET_KEY=

# Railway injects this automatically when you attach the Postgres plugin.
# Leave blank locally to fall back to a local SQLite file (web/local.db).
DATABASE_URL=

# "production" enables Secure cookies + HTTPS assumptions. Anything else = dev.
ENV=development

# Public origin, used to build the pairing URL shown in the desktop app.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Set to 1 to let anyone create an account. 0 = signup requires an invite code.
OPEN_SIGNUP=1
INVITE_CODE=
