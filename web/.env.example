# Copy to .env for local dev. On Railway, set these as service variables.

# Sign the session cookie. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# MUST be set in production. Rotating it logs everyone out.
SECRET_KEY=

# Railway injects this automatically when you attach the Postgres plugin.
# Leave blank locally to fall back to a local SQLite file (web/local.db).
DATABASE_URL=

# "production" enables Secure cookies + HTTPS assumptions. Anything else = dev.
ENV=development

# Public origin, used to build the pairing URL shown in the desktop app.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Set to 1 to let anyone create an account. 0 = signup requires an invite code.
# Keep this at 0 while there is no payment processor: an open signup hands out
# the paid feed entitlement for free.
OPEN_SIGNUP=0
INVITE_CODE=

# The shared password for the /plays board, and for reading the feed API without
# an account. REQUIRED — unset means nobody can read the plays, on the web or in
# the terminal. Subscribers get this string and nothing else; the desktop app
# reads the same value from RSAMAXXED_PLAYS_KEY in its own .env.
PLAYS_PASSWORD=

# Lets the operator's machine publish parsed alerts to the feed. Must EXACTLY
# match RSAMAXXED_FEED_KEY in the repo-root .env that publish_feed.py reads.
# Unset = the ingest endpoint 503s and NOTHING is ever published.
FEED_INGEST_KEY=

# Set to "" on a deploy: the desktop's picks.json doesn't exist there, and the
# feed arrives through POST /api/v1/plays/ingest instead.
PICKS_FILE=
